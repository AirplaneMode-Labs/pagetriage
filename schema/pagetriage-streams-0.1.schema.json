{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreamsReport",
  "description": "The result of `account_pdf_streams`.",
  "type": "object",
  "properties": {
    "limits": {
      "$ref": "#/$defs/StreamsLimits"
    },
    "notes": {
      "description": "Fixed sentences holding only numbers and kind names, never bytes taken from the document.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "$ref": "#/$defs/StreamsReason"
    },
    "schema": {
      "type": "string"
    },
    "streams": {
      "$ref": "#/$defs/StreamsSummary"
    },
    "verdict": {
      "$ref": "#/$defs/StreamsVerdict"
    }
  },
  "additionalProperties": false,
  "required": [
    "limits",
    "notes",
    "reason",
    "schema",
    "streams",
    "verdict"
  ],
  "$defs": {
    "StreamsKind": {
      "description": "Counts for one kind of stream (`font`, `image`, `content`, `form`, `other`).",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "decoded_bytes": {
          "description": "Bytes after decoding; a lower bound for a stream that hit its cap.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_decoded_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "over_limit": {
          "description": "A stream of this kind passed its limit (or, for an image, its raster limit).",
          "type": "boolean"
        },
        "raw_bytes": {
          "description": "Bytes as stored in the file.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "count",
        "decoded_bytes",
        "max_decoded_bytes",
        "over_limit",
        "raw_bytes"
      ]
    },
    "StreamsLimits": {
      "description": "The limits in force (the defaults, lowered by the caller's options).",
      "type": "object",
      "properties": {
        "content_decoded_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "font_decoded_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "image_decoded_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "image_raster_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "other_decoded_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "streams_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_decoded_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "content_decoded_max",
        "font_decoded_max",
        "image_decoded_max",
        "image_raster_max",
        "other_decoded_max",
        "streams_max",
        "total_decoded_max"
      ]
    },
    "StreamsReason": {
      "description": "Why a document is refused. `None` is the empty string and goes with the verdict `ok`.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "",
            "font_over_limit",
            "image_over_limit",
            "content_over_limit",
            "other_over_limit",
            "total_over_limit",
            "too_many_streams"
          ]
        },
        {
          "description": "The structure could not be vouched for: the parser could not load it, it needed repair, it is\nencrypted, a stream could not be classified or decoded under the bound, or the scan and the\nparser disagree about which streams exist.",
          "type": "string",
          "const": "unaccounted"
        }
      ]
    },
    "StreamsSummary": {
      "type": "object",
      "properties": {
        "by_kind": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/StreamsKind"
          }
        },
        "count": {
          "description": "Stream objects found. When more than `limits.streams_max` exist the count is `streams_max + 1`\nand the rest are not read.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "decoded_capped": {
          "description": "Some decoded count stopped at its cap, so the decoded figures are lower bounds.",
          "type": "boolean"
        },
        "early_stop": {
          "description": "Decoding stopped at the first violation; later streams are counted but not decoded.",
          "type": "boolean"
        },
        "total_decoded_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "by_kind",
        "count",
        "decoded_capped",
        "early_stop",
        "total_decoded_bytes"
      ]
    },
    "StreamsVerdict": {
      "description": "Whether the document may go on to a renderer.",
      "type": "string",
      "enum": [
        "ok",
        "refuse"
      ]
    }
  }
}
