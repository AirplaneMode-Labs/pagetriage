# Every text file is stored and checked out with LF, on every platform. Tests compare fixture bytes
# (canonical JSON, golden reports, signatures) byte for byte, and a CRLF checkout on Windows breaks them.
* text=auto eol=lf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary

# Vendored from AirplaneMode-Labs/runtime (spec release 0.6.1): the release tool, its record, and the shared vectors are hashed and
# signed byte for byte, so no checkout may convert their line endings (core.autocrlf=true included). tests/scripts/release-tool-vendored.sh
# clones with core.autocrlf=true and compares digests.
scripts/release/release-tool.mjs -text
scripts/release/VENDORED.json -text
tests/vectors/** -text
