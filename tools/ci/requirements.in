# Python tools the pagetriage wheels job installs (S1-079, TD-09). Exact versions only; the hashed lock next to this file is
# generated from it and is what CI installs:
#
#   uvx --from uv==0.13.1 uv pip compile --universal --python-version 3.12 --generate-hashes \
#       tools/ci/requirements.in -o tools/ci/requirements.txt
#
# Install (CI, and locally in a fresh venv):
#
#   python -m pip install --require-hashes --no-deps --only-binary=:all: -r tools/ci/requirements.txt
#
# uv        0.13.1  the uv the install proofs use (a `uv venv` install of the built wheel)
# maturin   1.16.0  builds the wheel and the sdist (the version scripts/package-python.sh and determinism.sh already use)
# ziglang   0.16.0  maturin --zig: the C compiler for the manylinux_2_17 wheel built on ubuntu
uv==0.13.1
maturin==1.16.0
ziglang==0.16.0
